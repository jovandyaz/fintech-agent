# Copy to .env only to override defaults; docker compose and the tooling already use these values.
# Each build step adds the variables it introduces.

# Required for agent runs and evals. Empty means runs end with error_code=no_api_key.
ANTHROPIC_API_KEY=

# Postgres (compose service `db`). Host port 5433 avoids clashing with a local 5432.
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot
POSTGRES_PORT=5433
DATABASE_URL=postgresql://copilot:copilot@localhost:5433/copilot
# Login passwords seed gives the three roles of specs/02-security.md G1; each service connects only as its own role.
# Compose builds the service URLs from these, so keep them URL-safe.
API_DB_PASSWORD=dev-api-db-password
EXECUTOR_DB_PASSWORD=dev-executor-db-password
MCP_DB_PASSWORD=dev-mcp-db-password
API_DATABASE_URL=postgresql://copilot_api:dev-api-db-password@localhost:5433/copilot
MCP_DATABASE_URL=postgresql://copilot_mcp:dev-mcp-db-password@localhost:5433/copilot
EXECUTOR_DATABASE_URL=postgresql://copilot_executor:dev-executor-db-password@localhost:5433/copilot

# API (compose service `api`).
API_PORT=3000
# Console operators as id:keyId:token, comma-separated; the API keeps only SHA-256 digests and logs the operator and
# key id, never the token (specs/02-security.md G3). Rotate a token by adding a new key id for the same operator.
OPERATOR_TOKENS=ana:k1:dev-operator-ana-token-0123456789,beto:k1:dev-operator-beto-token-0123456789

# Core-mock (compose service `core-mock`). The read key belongs to the MCP server and to the API, which checks that an
# operator's override names the case's own transactions; the executor key only to the executor and core-mock
# (specs/02-security.md G1).
CORE_MOCK_PORT=3010
CORE_MOCK_URL=http://localhost:3010
CORE_READ_KEY=dev-core-read-key
CORE_EXECUTOR_KEY=dev-core-executor-key

# Executor (compose service `executor`): how often it polls for approved actions when its queue is empty.
EXECUTOR_POLL_MS=1000

# MCP server (compose service `mcp`). MCP_AUDIENCE is the server's canonical URL and the `aud` of every case token,
# whatever address a client dials. CASE_TOKEN_KEY signs case tokens (HS256, at least 32 bytes); only api and mcp hold
# it, separate from the webhook secret and the executor key (specs/02-security.md G4).
MCP_PORT=3020
MCP_AUDIENCE=http://mcp:3020/mcp
# Hostnames clients may dial besides the audience host and loopback (comma-separated); the Host check runs before auth.
MCP_ALLOWED_HOSTS=mcp
CASE_TOKEN_KEY=dev-case-token-key-0123456789abcdef

# Console (compose service `console`, specs/04-build-plan.md Step 7): nginx serves it on CONSOLE_PORT and proxies /api to
# api. It has a fixed address on the compose subnet, and api trusts X-Forwarded-For from that address only
# (compose sets api's TRUST_PROXY to CONSOLE_IP), so the operator address it audits cannot be forged.
CONSOLE_PORT=5173
COMPOSE_SUBNET=10.231.0.0/24
COMPOSE_IP_RANGE=10.231.0.128/25
CONSOLE_IP=10.231.0.10

# Canaries (compose service `api`, specs/02-security.md G3). `pnpm canary:inject` posts one canary case per defect at
# random moments within this window, so they arrive spread out like real tickets; 0 posts them all at once.
CANARY_SPREAD_MS=300000

# Ticket webhook (compose service `api`, specs/01-architecture.md §Webhook and queue). Standard Webhooks v1: each secret
# is whsec_<base64>; list two separated by a space while one rotates out. `pnpm demo:post` signs with the first.
WEBHOOK_SECRET=whsec_ZGV2LXdlYmhvb2stc2VjcmV0LTAxMjM0NTY3ODlhYmNkZWY=

# Agent (compose service `api`, specs/01-architecture.md §The agentic node). AGENT_MODE=off is the kill switch: cases go
# to review with action none and no model call. Models must be in the dated price table; variant A is Sonnet-class and
# variant B Haiku-class. A run stops at the timeout, the USD ceiling or the input-token ceiling, whichever comes first;
# the input ceiling stays at or under 100000 (Haiku 5.5's lower price tier) and the timeout leaves the case token 60 s.
# The api dials MCP_URL and signs case tokens for MCP_AUDIENCE with CASE_TOKEN_KEY (above).
AGENT_MODE=on
# AGENT_WORKER=off runs api without the queue worker (HTTP only); AGENT_POLL_MS is how long an idle worker waits.
AGENT_WORKER=on
AGENT_POLL_MS=1000
AGENT_VARIANT=A
AGENT_MODEL_A=claude-sonnet-5-5
AGENT_MODEL_B=claude-haiku-5-5
REDACTOR_MODEL=claude-haiku-5-5
RUN_TIMEOUT_MS=180000
RUN_COST_CEILING_USD=0.5
RUN_INPUT_TOKEN_CEILING=60000
MCP_URL=http://localhost:3020/mcp

# Eval runner (`pnpm eval`, specs/03-evals.md §Runner, §Judge validation): the groundedness judge is an Opus-class model,
# neither variant under test; a run stops starting agent attempts once they have cost EVAL_SPEND_CAP_USD. At 12, the
# four attempts in flight (at most RUN_COST_CEILING_USD each) and the judge (~1) stay under the USD 15 approved.
JUDGE_MODEL=claude-opus-5-5
EVAL_SPEND_CAP_USD=12
