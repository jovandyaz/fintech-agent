# Copy to .env only to override defaults; docker compose and the tooling already use these values.
# Each build step adds the variables it introduces.

# Required for agent runs and evals. Empty means runs end with error_code=no_api_key.
ANTHROPIC_API_KEY=

# Postgres (compose service `db`). Host port 5433 avoids clashing with a local 5432.
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot
POSTGRES_PORT=5433
DATABASE_URL=postgresql://copilot:copilot@localhost:5433/copilot

# Core-mock (compose service `core-mock`). The read key belongs to the MCP server; the executor key only to the
# executor and core-mock (specs/02-security.md G1).
CORE_MOCK_PORT=3010
CORE_MOCK_URL=http://localhost:3010
CORE_READ_KEY=dev-core-read-key
CORE_EXECUTOR_KEY=dev-core-executor-key

# MCP server (compose service `mcp`). MCP_AUDIENCE is the server's canonical URL and the `aud` of every case token,
# whatever address a client dials. CASE_TOKEN_KEY signs case tokens (HS256, at least 32 bytes); only api and mcp hold
# it, separate from the webhook secret and the executor key (specs/02-security.md G4).
MCP_PORT=3020
MCP_AUDIENCE=http://mcp:3020/mcp
CASE_TOKEN_KEY=dev-case-token-key-0123456789abcdef
